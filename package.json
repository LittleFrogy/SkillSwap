{
  "name": "skillswap-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "start": "npm run start:backend",
    "start:backend": "npm --prefix backend run start",
    "start:frontend": "npm --prefix frontend run dev -- --host 0.0.0.0"
  }
}
